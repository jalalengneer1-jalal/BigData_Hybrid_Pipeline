# Set these as environment variables (this file is a template, not loaded automatically).
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DATABASE=bigdata_midterm
SMALL_FILE_THRESHOLD_MB=200
BATCH_SIZE=5000
SPARK_MASTER=local[*]
# Optional server-local directory allowed for POST /ingest; empty allows any local CSV.
INGEST_ALLOWED_ROOT=
VIEW_REFRESH_SECONDS=3600
REPORT_INTERVAL_SECONDS=86400
